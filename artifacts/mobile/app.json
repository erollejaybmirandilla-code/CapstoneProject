{
  "expo": {
    "name": "Legazpi Souvenir Market",
    "slug": "legazpi-souvenir-market",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAFAF8"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.legazpi.souvenirmarket"
    },
    "android": {
      "package": "com.legazpi.souvenirmarket",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#FAFAF8"
      }
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser"
    ],
    "extra": {
      "eas": {
        "projectId": "414d65cd-b95a-47c5-86e4-73990d89f05c"
      }
    },
    "owner": "e.mirandilla0",
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
