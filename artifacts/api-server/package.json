{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "start:win": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pkg": "pkg --targets node22-win-x64 --output dist/api-server-win.exe .",
    "pkg:all": "pkg --targets node22-win-x64,node22-linux-x64,node22-darwin-x64 --output dist/api-server ."
  },
  "pkg": {
    "assets": [
      "data/"
    ],
    "outputDirectory": "dist",
    "targets": [
      "node22-win-x64"
    ]
  },
  "dependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/express-session": "^1.19.0",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "catalog:",
    "cookie-parser": "^1.4.7",
    "cors": "^2",
    "drizzle-orm": "catalog:",
    "express": "^5",
    "express-session": "^1.19.0",
    "multer": "1.4.5-lts.2",
    "pino": "^9",
    "pino-http": "^10",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "catalog:",
    "esbuild": "^0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13",
    "pkg": "^5.8.1",
    "thread-stream": "3.1.0"
  }
}
